# HubSpot — where the optional "send me the report" email goes.
# Both values come from the form itself (Marketing → Forms → Share/Embed code);
# neither is a secret, they appear in every embedded HubSpot form.
VITE_HUBSPOT_PORTAL_ID=1234567
VITE_HUBSPOT_FORM_GUID=00000000-0000-0000-0000-000000000000

# Optional: the internal names of the two checkbox properties on that form.
# Leave one empty and that choice simply isn't sent. HubSpot rejects any
# submission containing a field the form doesn't have, so only name fields that
# actually exist on it.
# VITE_HUBSPOT_NEWSLETTER_FIELD=nyhedsbrev_tilmeldt
# VITE_HUBSPOT_SURVEYS_FIELD=fremtidige_undersoegelser

# Local development only: where the PHP endpoints are running (see KINSTA.md).
# VITE_DEV_API=http://localhost:8000

# Local development only: the MySQL the PHP endpoints write to. In production
# these are read from wp-config.php automatically.
# SURVEY_DB_NAME=zenegy_survey_local
# SURVEY_DB_USER=root
# SURVEY_DB_PASSWORD=
# SURVEY_DB_HOST=127.0.0.1
