# HubSpot form that takes the optional "send me the report" email.
# Neither value is a secret: both appear in the form's own embed code, which is
# public wherever the form is placed. They live here rather than in a local .env
# so a deploy from any machine produces the same build.
VITE_HUBSPOT_PORTAL_ID=143222932
VITE_HUBSPOT_FORM_GUID=e323b4cc-4280-4eab-aa85-af70cc6f177f

# The newsletter is a HubSpot subscription type, not a form field, so the tick is
# sent as consent against this id. 237167256 is the one every Zenegy marketing
# email already uses ("News about Zenegy products and services").
VITE_HUBSPOT_NEWSLETTER_SUBSCRIPTION_ID=237167256

# Alternatives, only if the form ever uses plain checkbox properties instead.
# A checkbox is hidden in the survey unless its destination is configured here.
VITE_HUBSPOT_NEWSLETTER_FIELD=
VITE_HUBSPOT_SURVEYS_FIELD=
